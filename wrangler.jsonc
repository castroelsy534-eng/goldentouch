{
  "name": "goldentouch",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "goldentouch-db", "database_id": "dce33375-be0f-4909-ab3a-8eca15bfd57e" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "triggers": { "crons": ["*/10 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
